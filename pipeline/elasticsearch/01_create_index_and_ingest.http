DELETE skincare_reviews

PUT skincare_reviews
{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "review_analyzer": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "english_stop",
            "english_stemmer"
          ]
        }
      },
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "review_id": { "type": "integer" },
      "product_id": { "type": "keyword" },
      "product_name": {
        "type": "text",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
      },
      "brand_name": { "type": "keyword" },
      "primary_category": { "type": "keyword" },
      "secondary_category": { "type": "keyword" },
      "tertiary_category": { "type": "keyword" },
      "price_usd": { "type": "float" },
      "rating": { "type": "integer" },
      "is_recommended": { "type": "integer" },
      "helpfulness": { "type": "float" },
      "total_feedback_count": { "type": "integer" },
      "total_neg_feedback_count": { "type": "integer" },
      "total_pos_feedback_count": { "type": "integer" },
      "submission_time": { "type": "date", "format": "yyyy-MM-dd" },
      "review_text": { "type": "text", "analyzer": "review_analyzer" },
      "review_title": { "type": "text", "analyzer": "review_analyzer" },
      "skin_tone": { "type": "keyword" },
      "eye_color": { "type": "keyword" },
      "skin_type": { "type": "keyword" },
      "hair_color": { "type": "keyword" }
    }
  }
}

# Terminal bulk ingestion command:
# bash pipeline/elasticsearch/bulk_ingest_chunks.sh

GET skincare_reviews/_count
